# Local development: no real emails sent, loopback-only development mailbox.
APP_ENV=development
HOST=127.0.0.1
PORT=8768
PUBLIC_URL=http://127.0.0.1:8768
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:8768,http://localhost:8768,http://127.0.0.1:5178
ADMIN_EMAIL=owner@haoke.local
MAIL_MODE=development
# Production: APP_ENV=production, MAIL_MODE=smtp, HTTPS PUBLIC_URL, explicit host/origin.
APP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
